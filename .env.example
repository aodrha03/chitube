# 바로 쓰려면 이 파일을 .env 로 복사 (없어도 기본값으로 동작)
# To use it, copy this file to .env (ChiTube also works without it, using the defaults)
#   cp .env.example .env
PORT=8945
TZ=Asia/Seoul

# NAS/리눅스: 저장 파일 소유자. SSH 에서 `id 계정명` 으로 확인 (맥은 0 그대로)
#   시놀로지 첫 관리자 계정은 보통 uid 1026 / gid 100(users)
# NAS/Linux: owner of saved files — check with `id <user>` over SSH (keep 0 on Mac). Synology: keep 0 unless you fixed folder ownership
PUID=0
PGID=0

# 영상 저장 위치 (비우면 이 폴더의 downloads/)
# Where videos are saved (default: downloads/ in this folder)
#   시놀로지 예: /volume1/video/YouTube    USB 외장: /volumeUSB1/usbshare/YouTube
#   리눅스 예:   /mnt/hdd/YouTube          맥 외장:  /Volumes/MyDrive/YouTube
DOWNLOAD_DIR=./downloads
